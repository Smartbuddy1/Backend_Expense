# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
FRONTEND_URL=http://localhost:5173

# Filled in once the database is set up (see docs/04-backend-plan.md and docs/05-database-schema.md)
DATABASE_URL=

# Filled in during Phase 1 (auth) — any long random string, e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# For receipt/bill photo uploads (expenses). Locally, get these from an IAM
# user scoped to S3 only. In production on EC2, prefer an instance role
# instead of long-lived keys — see docs/06-security.md and docs/07-aws-deployment.md.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
