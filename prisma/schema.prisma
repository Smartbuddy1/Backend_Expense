// ASEMS backend database schema — see ../../docs/05-database-schema.md for the full design doc.
// Only the `User` model exists so far (Phase 1 of ../../docs/04-backend-plan.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operations
  accountant
  site_supervisor
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  name         String
  mobile       String     @unique
  email        String?
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}
